# SQLite for local dev. For production use Postgres: change provider in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account (created by `npm run db:seed`)
ADMIN_EMAIL="admin@phantomfx.local"
ADMIN_PASSWORD="ChangeMe123!"

# ─────────────────────────────────────────────────────────────────────────────
# PRICE FEEDS — there are ALWAYS TWO SLOTS
#
# Demo accounts and live accounts are priced by two feeds that run at the same
# time, each with its own prices, candles, timer, failure counter and state
# machine. Which one answers is decided by the TYPE OF THE ACCOUNT resolved from
# the database on the server. A query parameter may name an account to look at
# (and ownership is checked), but a parameter can never select a feed, and never
# prices a trade.
#
# There is no shared-tape mode any more: `PRICE_FEED` alone does not merge the
# two slots, it only sets a default for both of them.
#
# Modes: "yahoo" | "twelvedata" | "simulated"
# Resolution per slot: 1) its own switch, 2) PRICE_FEED, 3) the role default.
# ─────────────────────────────────────────────────────────────────────────────

# Feed for DEMO accounts. Default if unset: "simulated".
DEMO_FEED="simulated"

# Feed for LIVE accounts — real money. Default if unset: "yahoo".
# Set this to "simulated" only together with LIVE_ALLOW_SIMULATED below.
LIVE_FEED="yahoo"

# Legacy switch, kept as a per-role fallback: applies to any slot that has no
# switch of its own. A warning is logged at startup when it is the only knob,
# because it also turns the LIVE slot into whatever it says.
# PRICE_FEED="simulated"

# ── Win-rate steering ────────────────────────────────────────────────────────
# Target win rate for DEMO accounts only (0.0–1.0). Empty disables steering.
# 0.6 = about 60% of demo trades reach take-profit instead of stop-loss.
# This selects NO provider: it only bends the demo slot's own tape. A live slot
# can never be steered — the configuration layer asserts it and the runtime
# throws if anything tries.
DEMO_WIN_RATE="0.6"

# ── Public / marketing ticker ────────────────────────────────────────────────
# Which slot the logged-out homepage ticker reads: "live" (default) or "demo".
# A real tape is what a public page should advertise; if that slot is degraded or
# paused the other one answers and the payload labels itself honestly.
PUBLIC_FEED="live"

# ── When a real provider is unavailable ──────────────────────────────────────
# Per-slot policy: "pause" (stop trading that slot and say why) or "simulate"
# (run that slot's own tape instead).
# Demo defaults to "simulate"; live defaults to "pause" and stays paused.
DEMO_FEED_ON_FAILURE="simulate"
LIVE_FEED_ON_FAILURE="pause"
# A live slot may only fall back to simulation if BOTH of these are true, so an
# accidental typo can never put real money on fake prices:
#   LIVE_FEED_ON_FAILURE="simulate"  and  LIVE_ALLOW_SIMULATED="true"
LIVE_ALLOW_SIMULATED="false"
# "true" is a STAGING setting, not a production one: it marks real accounts with
# prices this program invented. It is deliberate enough that a `running` live slot
# on it keeps every action, closes included — refusing them would trap positions
# with no exit — because the distinction is consent, not the nature of the mark.
# If a live slot falls back anyway (both switches on), it lands in "degraded":
# stop-loss, take-profit and stop-out still execute on those marks, new orders
# are refused, and every payload says the marks are simulated.
# Same rule at startup: a missing API key misconfigures the slot, it does not
# silently start a simulation.

# Consecutive provider failures before the policy above is applied.
FEED_FAILURE_THRESHOLD="3"

# Twelve Data (only needed when a slot uses "twelvedata"). Free tier: 800 calls/day.
# Empty key + a slot asking for twelvedata = that slot reports itself misconfigured.
TWELVE_DATA_API_KEY=""

# ── Staleness, per slot (milliseconds) ───────────────────────────────────────
# A feed with marks older than staleMs is "degraded" (held positions are still
# managed and closed; no new orders, no stop edits); older than pauseMs it is
# "paused" (nothing executes at all). Recovery needs two consecutive good polls
# so a flapping host cannot thrash the terminal.
LIVE_STALE_MS="15000"
LIVE_PAUSE_MS="60000"
DEMO_STALE_MS="30000"
DEMO_PAUSE_MS="120000"

# ── Market age, i.e. how old the PRICE is, not the connection (milliseconds) ───
# The four numbers above measure the transport: time since the host answered.
# A host can answer 200 forever while serving a print from Friday, and transport
# staleness cannot see that. These two measure the market: time since the newest
# print the provider actually served (Yahoo's `regularMarketTime`). Both ages are
# evaluated every time and the WORSE one decides the state, so a successful poll
# never promotes a dead tape back to running on its own.
# Defaults: degrade at 5 min, pause at 20 min. An open FX session prints every
# couple of seconds, so 5 minutes of silence means the source stopped forwarding
# quotes; past 20 minutes a fill is a guess at a price that no longer exists.
# A simulated tape is unaffected: its prints are stamped `now` by construction.
# LIVE_MARKET_* is one policy for both slots (market freshness belongs to the
# price, not the account); DEMO_MARKET_* may raise the demo slot's copy.
# This guard is INDEPENDENT of ENFORCE_MARKET_HOURS: that switch chooses which
# hours to trade, not whether a price is alive. With it set to false a closed
# market still drives the live slot degraded -> paused (weekends, and the daily
# rollover lull), while demo keeps running. Raise these only if you mean to trade
# aged-but-real quotes; a startup warning restates all of this.
LIVE_MARKET_STALE_MS="300000"
LIVE_MARKET_PAUSE_MS="1200000"
# DEMO_MARKET_STALE_MS / DEMO_MARKET_PAUSE_MS default to the LIVE_ values above.
# LIVE_MARKET_STALE_MS is also the PER-SYMBOL gate (A-11): the slot verdict reads
# the newest print on the tape, so one frozen pair inside a healthy batch never
# degrades the other nine. Instead `open` and `modify` on that pair are refused,
# naming the symbol and its age, while `close`, stop-loss/take-profit, stop-out and
# the display keep using its last mark — a frozen pair that admits it is frozen
# beats one that is hidden or that traps the position it is priced on. Aged pairs
# are listed in every feed payload as `staleSymbols` so a board can mark exactly
# those cells instead of calling the whole tape stale, and a protective close that
# settles on an aged mark is logged with the pair and its age — accepted residual
# risk, never a refusal: an unmanaged position is the worse harm.
# TWELVE DATA WEAKENS BOTH AGES: its /price body carries no print timestamp, so
# market age equals transport age there and a host serving an old number cannot be
# caught. That is a second, independent reason it is a backfill source and not an
# execution source (design §6), alongside the credit arithmetic below.

# ── Poll intervals (milliseconds) ────────────────────────────────────────────
# Yahoo is unofficial and rate-sensitive: one shared loop per provider mode,
# however many slots read it. Twelve Data's free tier wants minutes, not seconds:
# a batch costs one credit per symbol, so 10 symbols every 20 min is 720 of the
# 800 daily credits. Faster than that burns the key (429 -> the slot pauses).
# Defaults when unset: REMOTE 2500, TD 1200000, DEMO 250.
REMOTE_POLL_MS="2500"
TD_POLL_MS="1200000"
DEMO_POLL_MS="250"

# ── Twelve Data daily credit budget (design §6) ──────────────────────────────
# The startup arithmetic guard, so an unaffordable cadence is refused at boot
# instead of discovered mid-demo when the key starts answering 429.
# One batch = one credit PER SYMBOL, so a whole-set poll costs 10 credits and:
#   credits/day = ceil(86400000 / TD_POLL_MS) * 10
#   TD_POLL_MS=3000      -> 28800 polls x 10 = 288000 credits/day  (360x the tier)
#   TD_POLL_MS=1200000   ->     72 polls x 10 =    720 credits/day  (fits, 80 spare)
# Default 720, i.e. 800 minus headroom for candle backfill.
# LIVE_FEED=twelvedata above this budget: the live slot reports itself
#   "misconfigured" and prices nothing — a free key is a backfill source, not an
#   execution source. Set LIVE_FEED=yahoo, or raise this with a paid plan.
# DEMO_FEED=twelvedata above this budget: warns and runs its own simulated tape
#   instead (zero credits). The asymmetry is deliberate: an API budget must never
#   cost a demo its tape, and must never price real money on an exhausted key.
TD_DAILY_CREDIT_BUDGET="720"

# Enforce FX market hours (Sun 22:00 - Fri 22:00 UTC). "false" trades around the
# clock. A closed session parks a real-provider slot as "paused"; a simulated
# tape has no session and is never affected.
ENFORCE_MARKET_HOURS="false"

# Starting balance for demo accounts (USD)
DEMO_BALANCE="10000"
